{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.visual.config.ts",
    "playwright.smoke.config.ts",
    "tests/visual/ports.ts"
  ]
}

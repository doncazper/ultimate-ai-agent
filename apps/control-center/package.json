{
  "name": "@ultimate-ai-agent/control-center",
  "version": "0.104.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:icons": "vite --host 127.0.0.1 --open /icon-library.html",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "lint": "tsc -b --pretty false",
    "visual:capture": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "visual:check": "playwright test --config=playwright.visual.config.ts",
    "smoke:turn-router": "playwright test --config=playwright.smoke.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}

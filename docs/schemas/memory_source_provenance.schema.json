{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/memory_source_provenance.schema.json",
  "title": "UAA-P1-070 Memory Source Provenance Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_source_provenance_contract_ref",
    "memory_source_required_kinds",
    "memory_source_policy",
    "memory_source_denied_content_refs",
    "memory_source_review_posture",
    "memory_review_queue"
  ],
  "properties": {
    "memory_source_provenance_contract_ref": {
      "const": "contract-ref:memory-source-provenance:v1"
    },
    "memory_source_required_kinds": {
      "$ref": "#/$defs/source_kind_list"
    },
    "memory_source_policy": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "source_kind_ref",
          "safe_ref_prefix",
          "safe_summary_required",
          "review_required",
          "trusted_without_review",
          "source_payload_storage_allowed",
          "automatic_memory_write_allowed",
          "context_injection_allowed",
          "connector_runtime_allowed",
          "provider_or_model_authority_allowed",
          "account_auth_allowed"
        ],
        "properties": {
          "source_kind": { "$ref": "#/$defs/source_kind" },
          "source_kind_ref": { "$ref": "#/$defs/safe_ref" },
          "safe_ref_prefix": { "$ref": "#/$defs/safe_ref" },
          "safe_summary_required": { "const": true },
          "review_required": { "const": true },
          "trusted_without_review": { "const": false },
          "source_payload_storage_allowed": { "const": false },
          "automatic_memory_write_allowed": { "const": false },
          "context_injection_allowed": { "const": false },
          "connector_runtime_allowed": { "const": false },
          "provider_or_model_authority_allowed": { "const": false },
          "account_auth_allowed": { "const": false }
        }
      }
    },
    "memory_source_denied_content_refs": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/safe_ref" }
    },
    "memory_source_review_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_required_before_recall",
        "source_summary_trusted_without_review",
        "external_assistant_summary_trusted_without_review",
        "local_model_summary_trusted_without_review",
        "automatic_memory_write_enabled",
        "hidden_context_injection_enabled",
        "connector_runtime_enabled",
        "account_auth_enabled",
        "provider_or_model_authority_allowed",
        "source_payload_storage_allowed",
        "private_content_storage_allowed",
        "public_beta_claim_enabled",
        "public_distribution_claim_enabled",
        "production_authority_enabled"
      ],
      "properties": {
        "review_required_before_recall": { "const": true },
        "source_summary_trusted_without_review": { "const": false },
        "external_assistant_summary_trusted_without_review": { "const": false },
        "local_model_summary_trusted_without_review": { "const": false },
        "automatic_memory_write_enabled": { "const": false },
        "hidden_context_injection_enabled": { "const": false },
        "connector_runtime_enabled": { "const": false },
        "account_auth_enabled": { "const": false },
        "provider_or_model_authority_allowed": { "const": false },
        "source_payload_storage_allowed": { "const": false },
        "private_content_storage_allowed": { "const": false },
        "public_beta_claim_enabled": { "const": false },
        "public_distribution_claim_enabled": { "const": false },
        "production_authority_enabled": { "const": false }
      }
    },
    "memory_review_queue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_policy_ref",
          "source_kind",
          "source_kind_ref",
          "source_refs_status",
          "provenance_refs_status",
          "source_review_required",
          "source_trust_posture",
          "safe_summary_only",
          "source_truth_authority",
          "memory_write_authorized",
          "automatic_memory_write_authorized",
          "context_injection_authorized",
          "account_auth_enabled",
          "public_beta_claim_enabled",
          "public_distribution_claim_enabled",
          "production_authority_enabled",
          "source_payload_storage_allowed",
          "prompt_body_storage_allowed",
          "response_body_storage_allowed",
          "provider_body_storage_allowed",
          "path_body_storage_allowed",
          "log_body_storage_allowed",
          "account_ref_storage_allowed",
          "private_content_storage_allowed",
          "connector_runtime_allowed",
          "provider_or_model_authority_allowed",
          "accepted_as_truth"
        ],
        "properties": {
          "source_policy_ref": {
            "const": "contract-ref:memory-source-provenance:v1"
          },
          "source_kind": { "$ref": "#/$defs/source_kind" },
          "source_kind_ref": { "$ref": "#/$defs/safe_ref" },
          "source_refs_status": {
            "enum": [
              "safe_source_refs_present",
              "legacy_safe_refs_need_review",
              "missing_safe_source_refs"
            ]
          },
          "provenance_refs_status": {
            "enum": [
              "safe_provenance_refs_present",
              "missing_provenance_refs"
            ]
          },
          "source_review_required": { "const": true },
          "source_trust_posture": { "const": "untrusted_until_reviewed" },
          "safe_summary_only": { "const": true },
          "source_truth_authority": { "const": false },
          "memory_write_authorized": { "const": false },
          "automatic_memory_write_authorized": { "const": false },
          "context_injection_authorized": { "const": false },
          "account_auth_enabled": { "const": false },
          "public_beta_claim_enabled": { "const": false },
          "public_distribution_claim_enabled": { "const": false },
          "production_authority_enabled": { "const": false },
          "source_payload_storage_allowed": { "const": false },
          "prompt_body_storage_allowed": { "const": false },
          "response_body_storage_allowed": { "const": false },
          "provider_body_storage_allowed": { "const": false },
          "path_body_storage_allowed": { "const": false },
          "log_body_storage_allowed": { "const": false },
          "account_ref_storage_allowed": { "const": false },
          "private_content_storage_allowed": { "const": false },
          "connector_runtime_allowed": { "const": false },
          "provider_or_model_authority_allowed": { "const": false },
          "accepted_as_truth": { "const": false }
        }
      }
    }
  },
  "$defs": {
    "source_kind": {
      "enum": [
        "manual_note",
        "external_assistant_review_summary",
        "local_chat_summary",
        "local_coding_summary",
        "task_plan",
        "action_proposal",
        "evidence_timeline_ref",
        "read_only_calendar_metadata_ref",
        "read_only_email_metadata_ref",
        "crm_lite_business_record"
      ]
    },
    "source_kind_list": {
      "type": "array",
      "prefixItems": [
        { "const": "manual_note" },
        { "const": "external_assistant_review_summary" },
        { "const": "local_chat_summary" },
        { "const": "local_coding_summary" },
        { "const": "task_plan" },
        { "const": "action_proposal" },
        { "const": "evidence_timeline_ref" },
        { "const": "read_only_calendar_metadata_ref" },
        { "const": "read_only_email_metadata_ref" },
        { "const": "crm_lite_business_record" }
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    },
    "safe_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/inspectable_extension_catalog.schema.json",
  "title": "uaa_inspectable_extension_catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_ref",
    "catalog_status",
    "generated_from_ref",
    "entries",
    "read_only",
    "inspectable_catalog_enabled",
    "callable_catalog_enabled",
    "runtime_import_enabled",
    "execution_enabled",
    "connector_writes_enabled",
    "shell_execution_enabled",
    "network_access_enabled",
    "browser_automation_enabled",
    "mobile_control_enabled",
    "public_distribution_claimed",
    "blocked_capabilities",
    "docs_refs",
    "schema_refs",
    "safe_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "uaa_inspectable_extension_catalog.v1"
    },
    "catalog_ref": {
      "type": "string",
      "pattern": "^inspectable-catalog:[a-z0-9][a-z0-9_.:-]*$"
    },
    "catalog_status": {
      "const": "read_only_inspection"
    },
    "generated_from_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_.:-]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalog_entry"
      }
    },
    "read_only": {
      "const": true
    },
    "inspectable_catalog_enabled": {
      "const": true
    },
    "callable_catalog_enabled": {
      "const": false
    },
    "runtime_import_enabled": {
      "const": false
    },
    "execution_enabled": {
      "const": false
    },
    "connector_writes_enabled": {
      "const": false
    },
    "shell_execution_enabled": {
      "const": false
    },
    "network_access_enabled": {
      "const": false
    },
    "browser_automation_enabled": {
      "const": false
    },
    "mobile_control_enabled": {
      "const": false
    },
    "public_distribution_claimed": {
      "const": false
    },
    "blocked_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "docs_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safe_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "$defs": {
    "safe_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_.:-]*$"
    },
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_entry_ref",
        "manifest_ref",
        "package_identity",
        "provenance",
        "file_hashes",
        "declared_capabilities",
        "risk_class",
        "requested_grants",
        "activation_status",
        "blocked_state",
        "blocker_refs",
        "audit_refs",
        "safe_summary"
      ],
      "properties": {
        "catalog_entry_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "manifest_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "package_identity": {
          "$ref": "#/$defs/package_identity"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "file_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_hash"
          }
        },
        "declared_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declared_capability"
          }
        },
        "risk_class": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "requested_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requested_grant"
          }
        },
        "activation_status": {
          "enum": ["inactive", "blocked", "revoked", "future_scoped"]
        },
        "blocked_state": {
          "enum": ["not_blocked", "blocked", "unknown", "future_scoped"]
        },
        "blocker_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "audit_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "safe_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_ref",
        "package_name",
        "package_kind",
        "version_ref",
        "publisher_ref"
      ],
      "properties": {
        "package_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "package_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "package_kind": {
          "enum": ["plugin", "skill", "connector_manifest", "tooling_bundle"]
        },
        "version_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "publisher_ref": {
          "$ref": "#/$defs/safe_ref"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "review_ref",
        "license_ref",
        "provenance_status"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "review_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "license_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "provenance_status": {
          "enum": ["reviewed", "blocked", "unknown"]
        }
      }
    },
    "file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_ref", "hash_algorithm", "hash_value", "hash_status"],
      "properties": {
        "file_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "hash_value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash_status": {
          "enum": ["reviewed", "missing", "unknown"]
        }
      }
    },
    "declared_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ref", "capability_kind", "risk_class", "safe_purpose"],
      "properties": {
        "capability_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "capability_kind": {
          "enum": [
            "documentation_helper",
            "read_only_inspection",
            "local_preview",
            "tooling_metadata",
            "blocked_runtime"
          ]
        },
        "risk_class": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "safe_purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "requested_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_ref", "scope_ref", "status"],
      "properties": {
        "grant_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "scope_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "status": {
          "enum": ["requested", "blocked", "future_scoped"]
        }
      }
    }
  }
}

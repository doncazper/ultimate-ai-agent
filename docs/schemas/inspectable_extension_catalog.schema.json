{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/inspectable_extension_catalog.schema.json",
  "title": "uaa_inspectable_extension_catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_ref",
    "catalog_status",
    "generated_from_ref",
    "entries",
    "read_only",
    "inspectable_catalog_enabled",
    "progressive_disclosure_enabled",
    "metadata_first_index_enabled",
    "callable_catalog_enabled",
    "automatic_instruction_loading_enabled",
    "full_instruction_auto_load_enabled",
    "hidden_skill_activation_enabled",
    "skill_runtime_import_enabled",
    "external_marketplace_fetch_enabled",
    "runtime_import_enabled",
    "execution_enabled",
    "connector_writes_enabled",
    "shell_execution_enabled",
    "network_access_enabled",
    "browser_automation_enabled",
    "mobile_control_enabled",
    "public_distribution_claimed",
    "blocked_capabilities",
    "compact_skill_index_refs",
    "progressive_disclosure_refs",
    "skill_write_approval_gate",
    "skill_bundle_proposal_posture",
    "install_disabled_posture",
    "docs_refs",
    "schema_refs",
    "developer_guidance_refs",
    "final_hardening_refs",
    "safe_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "uaa_inspectable_extension_catalog.v1"
    },
    "catalog_ref": {
      "type": "string",
      "pattern": "^inspectable-catalog:[a-z0-9][a-z0-9_.:-]*$"
    },
    "catalog_status": {
      "const": "read_only_inspection"
    },
    "generated_from_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_.:-]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalog_entry"
      }
    },
    "read_only": {
      "const": true
    },
    "inspectable_catalog_enabled": {
      "const": true
    },
    "progressive_disclosure_enabled": {
      "const": true
    },
    "metadata_first_index_enabled": {
      "const": true
    },
    "callable_catalog_enabled": {
      "const": false
    },
    "automatic_instruction_loading_enabled": {
      "const": false
    },
    "full_instruction_auto_load_enabled": {
      "const": false
    },
    "hidden_skill_activation_enabled": {
      "const": false
    },
    "skill_runtime_import_enabled": {
      "const": false
    },
    "external_marketplace_fetch_enabled": {
      "const": false
    },
    "runtime_import_enabled": {
      "const": false
    },
    "execution_enabled": {
      "const": false
    },
    "connector_writes_enabled": {
      "const": false
    },
    "shell_execution_enabled": {
      "const": false
    },
    "network_access_enabled": {
      "const": false
    },
    "browser_automation_enabled": {
      "const": false
    },
    "mobile_control_enabled": {
      "const": false
    },
    "public_distribution_claimed": {
      "const": false
    },
    "blocked_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compact_skill_index_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "progressive_disclosure_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "skill_write_approval_gate": {
      "$ref": "#/$defs/skill_write_approval_gate"
    },
    "skill_bundle_proposal_posture": {
      "$ref": "#/$defs/skill_bundle_proposal_posture"
    },
    "install_disabled_posture": {
      "$ref": "#/$defs/extension_install_disabled_posture"
    },
    "docs_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "developer_guidance_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "final_hardening_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "safe_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "$defs": {
    "safe_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_.:-]*$"
    },
    "extension_install_disabled_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "posture_ref",
        "status",
        "candidate_count",
        "candidates",
        "required_authority_ref",
        "required_approval_ref",
        "verifier_refs",
        "docs_refs",
        "next_safe_action_refs",
        "blocked_authority_refs",
        "safe_refs_only",
        "read_only",
        "install_disabled_posture_enabled",
        "plugin_install_enabled",
        "plugin_enablement_enabled",
        "plugin_execution_enabled",
        "runtime_import_enabled",
        "connector_writes_enabled",
        "shell_execution_enabled",
        "network_access_enabled",
        "browser_automation_enabled",
        "provider_model_call_enabled",
        "remote_execution_enabled",
        "raw_manifest_content_stored",
        "raw_package_content_stored",
        "production_authority_granted",
        "side_effects_performed",
        "safe_summary"
      ],
      "properties": {
        "schema_version": {
          "const": "uaa_extension_install_disabled_posture.v1"
        },
        "posture_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "status": {
          "enum": [
            "blocked_pending_authority_and_approval",
            "review_ready_disabled_not_persisted"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension_install_disabled_candidate"
          }
        },
        "required_authority_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "required_approval_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "verifier_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "docs_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "next_safe_action_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "blocked_authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "safe_refs_only": {
          "const": true
        },
        "read_only": {
          "const": true
        },
        "install_disabled_posture_enabled": {
          "const": true
        },
        "plugin_install_enabled": {
          "const": false
        },
        "plugin_enablement_enabled": {
          "const": false
        },
        "plugin_execution_enabled": {
          "const": false
        },
        "runtime_import_enabled": {
          "const": false
        },
        "connector_writes_enabled": {
          "const": false
        },
        "shell_execution_enabled": {
          "const": false
        },
        "network_access_enabled": {
          "const": false
        },
        "browser_automation_enabled": {
          "const": false
        },
        "provider_model_call_enabled": {
          "const": false
        },
        "remote_execution_enabled": {
          "const": false
        },
        "raw_manifest_content_stored": {
          "const": false
        },
        "raw_package_content_stored": {
          "const": false
        },
        "production_authority_granted": {
          "const": false
        },
        "side_effects_performed": {
          "type": "array",
          "maxItems": 0
        },
        "safe_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 640
        }
      }
    },
    "extension_install_disabled_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "candidate_ref",
        "catalog_entry_ref",
        "package_ref",
        "manifest_ref",
        "version_ref",
        "source_package_ref",
        "provenance_ref",
        "static_review_ref",
        "sandbox_test_plan_ref",
        "tool_broker_mapping_ref",
        "event_ledger_plan_ref",
        "version_pin_ref",
        "revocation_plan_ref",
        "safe_disable_ref",
        "rollback_ref",
        "authority_lane_ref",
        "authority_decision_ref",
        "authority_decision_outcome",
        "authority_decision_reason_refs",
        "required_mode",
        "required_domain",
        "required_capability",
        "manifest_security_decision_ref",
        "install_review_decision_ref",
        "receipt_plan_ref",
        "audit_refs",
        "receipt_refs",
        "file_hashes",
        "blocked_capability_refs",
        "approval_request_ref",
        "approval_ref",
        "exact_approval_required",
        "local_approval_validated",
        "approval_validation_status",
        "approval_ref_authority",
        "disabled_install_record_ready",
        "disabled_install_record_persisted",
        "plugin_install_enabled",
        "plugin_enablement_enabled",
        "plugin_execution_enabled",
        "runtime_import_enabled",
        "connector_writes_enabled",
        "shell_execution_enabled",
        "network_access_enabled",
        "browser_automation_enabled",
        "provider_model_call_enabled",
        "remote_execution_enabled",
        "raw_manifest_content_stored",
        "raw_package_content_stored",
        "production_authority_granted",
        "side_effects_performed",
        "safe_summary"
      ],
      "properties": {
        "schema_version": {
          "const": "uaa_extension_install_disabled_candidate.v1"
        },
        "candidate_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "catalog_entry_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "package_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "manifest_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "version_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "source_package_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "provenance_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "static_review_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "sandbox_test_plan_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "tool_broker_mapping_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "event_ledger_plan_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "version_pin_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "revocation_plan_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "safe_disable_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "rollback_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "authority_lane_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "authority_decision_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "authority_decision_outcome": {
          "enum": ["allow", "ask", "deny", "degrade_to_draft"]
        },
        "authority_decision_reason_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "required_mode": {
          "const": "approved_safe_local_work_session"
        },
        "required_domain": {
          "const": "workspace"
        },
        "required_capability": {
          "const": "write"
        },
        "manifest_security_decision_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "install_review_decision_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "receipt_plan_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "audit_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "file_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension_install_disabled_file_hash"
          }
        },
        "blocked_capability_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "approval_request_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "approval_ref": {
          "anyOf": [
            {"$ref": "#/$defs/safe_ref"},
            {"type": "null"}
          ]
        },
        "exact_approval_required": {
          "const": true
        },
        "local_approval_validated": {
          "type": "boolean"
        },
        "approval_validation_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "approval_ref_authority": {
          "const": false
        },
        "disabled_install_record_ready": {
          "type": "boolean"
        },
        "disabled_install_record_persisted": {
          "const": false
        },
        "plugin_install_enabled": {
          "const": false
        },
        "plugin_enablement_enabled": {
          "const": false
        },
        "plugin_execution_enabled": {
          "const": false
        },
        "runtime_import_enabled": {
          "const": false
        },
        "connector_writes_enabled": {
          "const": false
        },
        "shell_execution_enabled": {
          "const": false
        },
        "network_access_enabled": {
          "const": false
        },
        "browser_automation_enabled": {
          "const": false
        },
        "provider_model_call_enabled": {
          "const": false
        },
        "remote_execution_enabled": {
          "const": false
        },
        "raw_manifest_content_stored": {
          "const": false
        },
        "raw_package_content_stored": {
          "const": false
        },
        "production_authority_granted": {
          "const": false
        },
        "side_effects_performed": {
          "type": "array",
          "maxItems": 0
        },
        "safe_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 520
        }
      }
    },
    "extension_install_disabled_file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_ref",
        "hash_algorithm",
        "hash_value",
        "hash_status"
      ],
      "properties": {
        "file_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "hash_value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {"type": "null"}
          ]
        },
        "hash_status": {
          "enum": ["reviewed", "missing"]
        }
      }
    },
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_entry_ref",
        "manifest_ref",
        "compact_skill_index_ref",
        "metadata_summary_ref",
        "package_identity",
        "provenance",
        "file_hashes",
        "declared_capabilities",
        "risk_class",
        "requested_grants",
        "activation_status",
        "blocked_state",
        "blocker_refs",
        "audit_refs",
        "visibility_status",
        "trust_posture",
        "callable_posture",
        "required_grant_refs",
        "blocked_reason",
        "review_evidence_refs",
        "safe_adoption_posture",
        "progressive_disclosure_status",
        "full_instruction_load_posture",
        "metadata_first",
        "operator_selected_before_full_instruction",
        "automatic_instruction_loading_enabled",
        "hidden_activation_enabled",
        "safe_summary"
      ],
      "properties": {
        "catalog_entry_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "manifest_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "compact_skill_index_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "metadata_summary_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "package_identity": {
          "$ref": "#/$defs/package_identity"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "file_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_hash"
          }
        },
        "declared_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declared_capability"
          }
        },
        "risk_class": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "requested_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requested_grant"
          }
        },
        "activation_status": {
          "enum": ["inactive", "blocked", "revoked", "future_scoped"]
        },
        "blocked_state": {
          "enum": ["not_blocked", "blocked", "unknown", "future_scoped"]
        },
        "blocker_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "audit_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "visibility_status": {
          "enum": [
            "implemented",
            "partial",
            "planned",
            "mock_only",
            "blocked",
            "deprecated",
            "contradicted",
            "unknown"
          ]
        },
        "trust_posture": {
          "enum": [
            "reviewed_metadata",
            "unknown_blocked",
            "blocked_by_policy",
            "future_review_required"
          ]
        },
        "callable_posture": {
          "enum": [
            "inspectable_only",
            "blocked_runtime",
            "future_exact_lane_required"
          ]
        },
        "required_grant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "blocked_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "review_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "safe_adoption_posture": {
          "enum": [
            "repo_owned_metadata_only",
            "reviewed_adaptation_required",
            "blocked_until_scoped_milestone"
          ]
        },
        "progressive_disclosure_status": {
          "enum": [
            "metadata_indexed",
            "full_instructions_blocked",
            "future_review_required",
            "blocked"
          ]
        },
        "full_instruction_load_posture": {
          "enum": [
            "metadata_only",
            "operator_selected_review_required",
            "blocked_runtime_import"
          ]
        },
        "metadata_first": {
          "const": true
        },
        "operator_selected_before_full_instruction": {
          "const": true
        },
        "automatic_instruction_loading_enabled": {
          "const": false
        },
        "hidden_activation_enabled": {
          "const": false
        },
        "safe_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "skill_write_approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "gate_ref",

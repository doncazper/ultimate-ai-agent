        "direct_skill_write_enabled",
        "skill_enablement_enabled",
        "runtime_import_enabled",
        "execution_enabled",
        "connector_writes_enabled",
        "shell_execution_enabled",
        "provider_model_call_enabled",
        "browser_automation_enabled",
        "production_authority_enabled"
      ],
      "properties": {
        "schema_version": {
          "const": "uaa_skill_write_approval_gate.v1"
        },
        "gate_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "status": {
          "const": "staged_review_only"
        },
        "proposal_count": {
          "type": "integer",
          "minimum": 0
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill_write_proposal"
          }
        },
        "review_queue_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "required_authority_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "blocked_authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "verifier_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "next_safe_action_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "safe_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "file_write_enabled": {
          "const": false
        },
        "direct_skill_write_enabled": {
          "const": false
        },
        "skill_enablement_enabled": {
          "const": false
        },
        "runtime_import_enabled": {
          "const": false
        },
        "execution_enabled": {
          "const": false
        },
        "connector_writes_enabled": {
          "const": false
        },
        "shell_execution_enabled": {
          "const": false
        },
        "provider_model_call_enabled": {
          "const": false
        },
        "browser_automation_enabled": {
          "const": false
        },
        "production_authority_enabled": {
          "const": false
        }
      }
    },
    "skill_bundle_proposal_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "posture_ref",
        "status",
        "proposal_count",
        "proposals",
        "bundle_review_queue_ref",
        "required_authority_ref",
        "blocked_authority_refs",
        "verifier_refs",
        "next_safe_action_refs",
        "safe_summary",
        "bundle_activation_enabled",
        "skill_enablement_enabled",
        "tool_execution_enabled",
        "context_injection_enabled",
        "runtime_import_enabled",
        "provider_model_call_enabled",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_type": {
      "title": "Adapter Type",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "exposed_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Exposed Capabilities",
      "type": "array"
    }
  },
  "required": [
    "adapter_id",
    "adapter_type",
    "version"
  ],
  "title": "AgentRuntimeAdapterManifest",
  "type": "object"
}

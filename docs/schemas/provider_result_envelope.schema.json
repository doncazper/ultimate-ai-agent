{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/provider_result_envelope.schema.json",
  "title": "ProviderResultEnvelope",
  "type": "object",
  "required": [
    "provider_id",
    "domain",
    "capability",
    "fetched_at",
    "normalized",
    "confidence",
    "freshness_seconds",
    "schema_version"
  ],
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "normalized": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_seconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cost": {
      "type": "object",
      "additionalProperties": true
    },
    "terms": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

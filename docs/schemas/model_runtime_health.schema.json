{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelRuntimeHealth",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runtime_id": {
      "type": "string"
    },
    "checked_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline",
        "unknown"
      ]
    },
    "model_loaded": {
      "type": "boolean"
    },
    "effective_context_limit_tokens": {
      "type": "integer"
    },
    "latency_ms": {
      "type": "number"
    },
    "tokens_per_second": {
      "type": "number"
    },
    "resource_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability_probe_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "runtime_id",
    "checked_at",
    "status"
  ]
}

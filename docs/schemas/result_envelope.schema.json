{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/result_envelope.schema.json",
  "title": "ResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "operation",
    "service",
    "trace_id",
    "created_at"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {},
    "error": {
      "oneOf": [
        {
          "$ref": "error_envelope.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "default": []
    },
    "cost_attribution": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "redactions_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "rollback_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "public",
        "user_private",
        "project_private",
        "sensitive_personal",
        "credential_secret",
        "regulated",
        "third_party_confidential",
        "system_internal",
        "tcb_protected",
        null
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

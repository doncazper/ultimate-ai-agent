{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uaa_repo_awareness_benchmark",
  "description": "Deterministic repo awareness self-grade snapshot. Stores safe summaries, scores, blockers, and evidence refs only.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_ref",
    "benchmark_id",
    "generated_at_utc",
    "reason",
    "scan_mode",
    "baseline_ref",
    "commit_ref",
    "score_summary",
    "categories",
    "weekly_review_model",
    "non_goals",
    "report_safety"
  ],
  "properties": {
    "schema_version": {
      "const": "uaa_repo_awareness_benchmark.v1"
    },
    "task_ref": {
      "const": "UAA-BENCH-001"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^repo-awareness-benchmark:[a-z0-9][a-z0-9:-]*$"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "scan_mode": {
      "const": "whole_repo_deterministic"
    },
    "baseline_ref": {
      "type": "string",
      "pattern": "^baseline:[A-Za-z0-9._:-]+$"
    },
    "commit_ref": {
      "type": "string",
      "pattern": "^commit:([a-f0-9]{7,64}|unknown)$"
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "overall_score",
        "overall_tier",
        "category_weights",
        "safe_summary"
      ],
      "properties": {
        "overall_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "overall_tier": {
          "$ref": "#/$defs/tier"
        },
        "category_weights": {
          "type": "object"
        },
        "safe_summary": {
          "type": "string"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "weekly_review_model": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "command",
        "unattended_repo_writes",
        "auto_commit"
      ],
      "properties": {
        "mode": {
          "const": "reminder_plus_manual_command"
        },
        "command": {
          "type": "string"
        },
        "unattended_repo_writes": {
          "const": false
        },
        "auto_commit": {
          "const": false
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_safety": {
      "$ref": "#/$defs/report_safety"
    }
  },
  "$defs": {
    "tier": {
      "enum": [
        "blocked",
        "emerging",
        "stabilizing",
        "rc_watch",
        "rc_ready"
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "score",
        "tier",
        "safe_summary",
        "evidence_refs",
        "metrics",
        "blockers"
      ],
      "properties": {
        "id": {
          "enum": [
            "module_maturity",
            "route_product_surface",
            "verifier_evidence_coverage",
            "safety_boundary_health",
            "performance_state",
            "rc_readiness_blockers"
          ]
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "safe_summary": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "object"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "report_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_prompt_included",
        "raw_response_included",
        "raw_provider_payload_included",
        "raw_path_included",
        "raw_log_included",
        "username_included",
        "hostname_included",
        "serial_included",
        "environment_dump_included",
        "credential_material_included"
      ],
      "properties": {
        "raw_prompt_included": {
          "const": false
        },
        "raw_response_included": {
          "const": false
        },
        "raw_provider_payload_included": {
          "const": false
        },
        "raw_path_included": {
          "const": false
        },
        "raw_log_included": {
          "const": false
        },
        "username_included": {
          "const": false
        },
        "hostname_included": {
          "const": false
        },
        "serial_included": {
          "const": false
        },
        "environment_dump_included": {
          "const": false
        },
        "credential_material_included": {
          "const": false
        }
      }
    }
  }
}

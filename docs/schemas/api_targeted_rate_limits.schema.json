{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/api_targeted_rate_limits.schema.json",
  "title": "UAA-P1-085 targeted local rate limits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dependencies_added",
    "distributed_quota_store_added",
    "local_in_memory_fixed_window",
    "policy_ref",
    "posture_field",
    "production_authority_enabled",
    "rate_limits_are_auth",
    "runtime_middleware_added",
    "targeted_field",
    "targeted_groups",
    "targeted_route_count"
  ],
  "properties": {
    "policy_ref": {
      "const": "rate-limit:p1-085:targeted-local:v1"
    },
    "targeted_groups": {
      "type": "array",
      "items": {
        "enum": [
          "action_preview_proposal",
          "chat_durable_receipt",
          "local_model_validation",
          "memory_feedback",
          "memory_context_pack_action_proposal",
          "memory_review_decision",
          "model_chat",
          "provider_credential_validation",
          "provider_exact_approved_lane",
          "provider_router_dry_run",
          "governed_runtime_pilot",
          "extension_install_disabled_record",
          "today_to_action_envelope",
          "action_decision",
          "task_decomposition",
          "web_evidence_product_slice"
        ]
      },
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true
    },
    "targeted_route_count": {
      "const": 70
    },
    "posture_field": {
      "const": "rate_limit_posture"
    },
    "targeted_field": {
      "const": "rate_limit_targeted"
    },
    "runtime_middleware_added": {
      "const": true
    },
    "local_in_memory_fixed_window": {
      "const": true
    },
    "distributed_quota_store_added": {
      "const": false
    },
    "dependencies_added": {
      "const": false
    },
    "rate_limits_are_auth": {
      "const": false
    },
    "production_authority_enabled": {
      "const": false
    }
  }
}

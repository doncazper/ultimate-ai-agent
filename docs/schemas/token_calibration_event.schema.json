{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenCalibrationEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "model_runtime_ref": {
      "type": "string"
    },
    "previous_factor": {
      "type": "number"
    },
    "new_factor": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "actual_tokens": {
      "type": "integer"
    },
    "estimated_tokens": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "model_runtime_ref",
    "previous_factor",
    "new_factor",
    "created_at"
  ]
}

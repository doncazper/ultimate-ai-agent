{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/cross_surface_memory_intake.schema.json",
  "title": "UAA-P1-076 Cross-Surface Memory Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cross_surface_memory_intake_contract_ref",
    "cross_surface_memory_intake_status",
    "cross_surface_memory_intake_required_surfaces",
    "cross_surface_memory_intake_required_ref_fields",
    "cross_surface_memory_intake_required_blocked_refs",
    "cross_surface_memory_intake_proposal_count",
    "cross_surface_memory_intake_proposals",
    "cross_surface_memory_intake_surface_bindings",
    "cross_surface_memory_intake_authority_posture",
    "cross_surface_memory_intake_blocked_state_refs"
  ],
  "properties": {
    "cross_surface_memory_intake_contract_ref": {
      "const": "contract-ref:cross-surface-memory-intake:v1"
    },
    "cross_surface_memory_intake_status": {
      "const": "implemented_review_only_proposal_intake_contract"
    },
    "cross_surface_memory_intake_required_surfaces": {
      "type": "array",
      "minItems": 7,
      "items": { "type": "string" }
    },
    "cross_surface_memory_intake_required_ref_fields": {
      "type": "array",
      "minItems": 14,
      "items": { "type": "string" }
    },
    "cross_surface_memory_intake_required_blocked_refs": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "string" }
    },
    "cross_surface_memory_intake_proposal_count": { "const": 7 },
    "cross_surface_memory_intake_proposals": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_ref",
          "proposal_ref",
          "surface",
          "source_kind",
          "candidate_kind",
          "candidate_ref",
          "safe_summary",
          "source_refs",
          "source_provenance_contract_ref",
          "memory_review_decision_contract_ref",
          "business_memory_quality_contract_ref",
          "source_trust_posture",
          "provenance_refs",
          "evidence_refs",
          "quality_state_refs",
          "missing_evidence_refs",
          "missing_evidence_posture",
          "confidence_posture",
          "stale_state",
          "next_safe_action",
          "review_queue_ref",
          "review_required",
          "safe_summary_only",
          "source_payload_storage_allowed",
          "memory_write_authorized",
          "automatic_memory_write_authorized",
          "context_injection_authorized",
          "provider_call_enabled",
          "account_fetch_enabled",
          "browser_import_enabled",
          "shell_history_import_enabled",
          "raw_file_import_enabled",
          "connector_runtime_enabled",
          "source_truth_authority",
          "accepted_as_recall",
          "public_beta_claim_enabled",
          "public_distribution_claim_enabled",
          "production_authority_enabled",
          "blocked_state_refs"
        ],
        "properties": {
          "contract_ref": {
            "const": "contract-ref:cross-surface-memory-intake:v1"
          },
          "proposal_ref": { "type": "string" },
          "surface": {
            "enum": [
              "Today",
              "Chat",
              "Plans",
              "Actions",
              "Evidence",
              "Local Coding",
              "External Assistant Review"
            ]
          },
          "source_kind": { "type": "string" },
          "candidate_kind": { "type": "string" },
          "candidate_ref": { "type": "string" },
          "safe_summary": { "type": "string" },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "source_provenance_contract_ref": {
            "const": "contract-ref:memory-source-provenance:v1"
          },
          "memory_review_decision_contract_ref": {
            "const": "contract-ref:memory-review-decision:v1"
          },
          "business_memory_quality_contract_ref": {
            "const": "contract-ref:business-memory-quality-controls:v1"
          },
          "source_trust_posture": { "const": "untrusted_until_reviewed" },
          "provenance_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "quality_state_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "missing_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "missing_evidence_posture": {
            "const": "missing_safe_evidence_until_reviewed"
          },
          "confidence_posture": { "const": "low_confidence_until_reviewed" },
          "stale_state": {
            "const": "recheck_source_refs_before_memory_intake"
          },
          "next_safe_action": { "type": "string" },
          "review_queue_ref": { "type": "string" },
          "review_required": { "const": true },
          "safe_summary_only": { "const": true },
          "source_payload_storage_allowed": { "const": false },
          "memory_write_authorized": { "const": false },
          "automatic_memory_write_authorized": { "const": false },
          "context_injection_authorized": { "const": false },
          "provider_call_enabled": { "const": false },
          "account_fetch_enabled": { "const": false },
          "browser_import_enabled": { "const": false },
          "shell_history_import_enabled": { "const": false },
          "raw_file_import_enabled": { "const": false },
          "connector_runtime_enabled": { "const": false },
          "source_truth_authority": { "const": false },
          "accepted_as_recall": { "const": false },
          "public_beta_claim_enabled": { "const": false },
          "public_distribution_claim_enabled": { "const": false },
          "production_authority_enabled": { "const": false },
          "blocked_state_refs": {
            "type": "array",
            "minItems": 12,
            "items": { "type": "string" }
          }
        }
      }
    },
    "cross_surface_memory_intake_surface_bindings": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "feed_status",
          "feed_ref",
          "authority_boundary"
        ],
        "properties": {
          "surface": { "type": "string" },
          "feed_status": { "type": "string" },
          "feed_ref": { "type": "string" },
          "authority_boundary": { "type": "string" }
        }
      }
    },
    "cross_surface_memory_intake_authority_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_refs_only",
        "review_required",
        "safe_summary_only",
        "source_payload_storage_allowed",
        "memory_write_authorized",
        "automatic_memory_write_authorized",
        "context_injection_authorized",
        "provider_call_enabled",
        "account_fetch_enabled",
        "browser_import_enabled",
        "shell_history_import_enabled",
        "raw_file_import_enabled",
        "connector_runtime_enabled",
        "source_truth_authority",
        "accepted_as_recall",
        "public_beta_claim_enabled",
        "public_distribution_claim_enabled",
        "production_authority_enabled"
      ],
      "properties": {
        "safe_refs_only": { "const": true },
        "review_required": { "const": true },
        "safe_summary_only": { "const": true },
        "source_payload_storage_allowed": { "const": false },
        "memory_write_authorized": { "const": false },
        "automatic_memory_write_authorized": { "const": false },
        "context_injection_authorized": { "const": false },
        "provider_call_enabled": { "const": false },
        "account_fetch_enabled": { "const": false },
        "browser_import_enabled": { "const": false },
        "shell_history_import_enabled": { "const": false },
        "raw_file_import_enabled": { "const": false },
        "connector_runtime_enabled": { "const": false },
        "source_truth_authority": { "const": false },
        "accepted_as_recall": { "const": false },
        "public_beta_claim_enabled": { "const": false },
        "public_distribution_claim_enabled": { "const": false },
        "production_authority_enabled": { "const": false }
      }
    },
    "cross_surface_memory_intake_blocked_state_refs": {
      "type": "array",
      "minItems": 12,
      "items": { "type": "string" }
    }
  }
}

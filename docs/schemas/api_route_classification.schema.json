{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/api_route_classification.schema.json",
  "title": "UAA-P1-080 API route classification inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_count",
    "route_classification_vocabulary",
    "route_classification_summary",
    "route_auth_posture_summary",
    "route_approval_posture_summary",
    "route_idempotency_posture_summary",
    "idempotency_audit_policy_ref",
    "route_rate_limit_posture_summary",
    "rate_limit_policy_ref",
    "routes",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "uaa-api-route-inventory.v4"
    },
    "route_count": {
      "const": 164
    },
    "route_classification_vocabulary": {
      "type": "array",
      "items": {
        "enum": [
          "public_metadata",
          "local_readonly",
          "local_sensitive",
          "mutating_requires_authority"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "route_classification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_metadata",
        "local_readonly",
        "local_sensitive",
        "mutating_requires_authority"
      ],
      "properties": {
        "public_metadata": {
          "type": "integer",
          "minimum": 0
        },
        "local_readonly": {
          "type": "integer",
          "minimum": 0
        },
        "local_sensitive": {
          "type": "integer",
          "minimum": 0
        },
        "mutating_requires_authority": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "route_auth_posture_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_metadata_no_auth",
        "protected_local_bearer_required"
      ],
      "properties": {
        "public_metadata_no_auth": {
          "type": "integer",
          "const": 3
        },
        "protected_local_bearer_required": {
          "type": "integer",
          "const": 161
        }
      }
    },
    "route_approval_posture_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_required_for_route_classification",
        "required_before_mutation_authority"
      ],
      "properties": {
        "not_required_for_route_classification": {
          "type": "integer",
          "const": 130
        },
        "required_before_mutation_authority": {
          "type": "integer",
          "const": 34
        }
      }
    },
    "route_idempotency_posture_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_required_for_route_classification",
        "required_before_mutation_authority"
      ],
      "properties": {
        "not_required_for_route_classification": {
          "type": "integer",
          "minimum": 0
        },
        "required_before_mutation_authority": {
          "type": "integer",
          "const": 34
        }
      }
    },
    "idempotency_audit_policy_ref": {
      "const": "idempotency:p1-084:mutating-routes:v1"
    },
    "route_rate_limit_posture_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_targeted_for_route",
        "targeted_local_fixed_window"
      ],
      "properties": {
        "not_targeted_for_route": {
          "type": "integer",
          "minimum": 0
        },
        "targeted_local_fixed_window": {
          "type": "integer",
          "const": 56
        }
      }
    },
    "rate_limit_policy_ref": {
      "const": "rate-limit:p1-085:targeted-local:v1"
    },
    "routes": {
      "type": "array",
      "minItems": 164,
      "maxItems": 164,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "operation_id",
          "path",
          "route_classification",
          "auth_posture",
          "approval_posture",
          "idempotency_required",
          "idempotency_posture",
          "idempotency_policy_ref",
          "rate_limit_targeted",
          "rate_limit_posture",
          "rate_limit_policy_ref",
          "rate_limit_group",
          "side_effect_class",
          "summary",
          "tags"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "side_effect_class": {
            "enum": [
              "none",
              "validation_only",
              "local_dev_workspace_only",
              "governed_network_read_only"
            ]
          },
          "route_classification": {
            "enum": [
              "public_metadata",
              "local_readonly",
              "local_sensitive",
              "mutating_requires_authority"
            ]
          },
          "auth_posture": {
            "enum": [
              "public_metadata_no_auth",
              "protected_local_bearer_required"
            ]
          },
          "approval_posture": {
            "enum": [
              "not_required_for_route_classification",
              "required_before_mutation_authority"
            ]
          },
          "idempotency_required": {
            "type": "boolean"
          },
          "idempotency_posture": {
            "enum": [
              "not_required_for_route_classification",
              "required_before_mutation_authority"
            ]
          },
          "idempotency_policy_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "rate_limit_targeted": {
            "type": "boolean"
          },
          "rate_limit_posture": {
            "enum": [
              "not_targeted_for_route",
              "targeted_local_fixed_window"
            ]
          },
          "rate_limit_policy_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "rate_limit_group": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "action_preview_proposal",
              "action_decision",
              "chat_durable_receipt",
              "local_model_validation",
              "memory_feedback",
              "memory_context_pack_action_proposal",
              "memory_review_decision",
              "model_chat",
              "provider_credential_validation",
              "provider_exact_approved_lane",
              "provider_router_dry_run",
              "today_to_action_envelope",
              "task_decomposition",
              null
            ]
          }
        }
      }
    }
  }
}

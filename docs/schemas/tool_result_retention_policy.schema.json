{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolResultRetentionPolicy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "tool_category": {
      "type": "string"
    },
    "raw_retention_target": {
      "type": "string"
    },
    "max_inline_tokens": {
      "type": "integer"
    },
    "summarize_before_context": {
      "type": "boolean"
    },
    "artifact_required": {
      "type": "boolean"
    },
    "redaction_required": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "tool_category",
    "max_inline_tokens"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/api_mutating_route_idempotency_audit.schema.json",
  "title": "UAA P1 084 Mutating Route Idempotency Audit Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_ref",
    "applies_to_route_classification",
    "required_input_kinds",
    "accepted_header_names",
    "mutating_route_count",
    "manifest_field",
    "posture_field",
    "runtime_middleware_added",
    "durable_dedupe_store_added",
    "request_header_required_by_middleware",
    "mutation_authority_granted",
    "production_authority_enabled"
  ],
  "properties": {
    "policy_ref": {
      "const": "idempotency:p1-084:mutating-routes:v1"
    },
    "applies_to_route_classification": {
      "const": "mutating_requires_authority"
    },
    "required_input_kinds": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "idempotency_key",
          "idempotency_key_ref",
          "idempotency_ref",
          "scoped_idempotency_ref"
        ]
      }
    },
    "accepted_header_names": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "x-uaa-idempotency-key",
          "x-uaa-idempotency-ref"
        ]
      }
    },
    "mutating_route_count": {
      "const": 49
    },
    "manifest_field": {
      "const": "idempotency_required"
    },
    "posture_field": {
      "const": "idempotency_posture"
    },
    "runtime_middleware_added": {
      "const": true
    },
    "durable_dedupe_store_added": {
      "const": false
    },
    "request_header_required_by_middleware": {
      "const": true
    },
    "mutation_authority_granted": {
      "const": false
    },
    "production_authority_enabled": {
      "const": false
    }
  }
}

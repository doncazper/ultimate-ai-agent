{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/trace_span.schema.json",
  "title": "TraceSpan",
  "type": "object",
  "required": [
    "span_id",
    "run_id",
    "name",
    "started_at",
    "status",
    "schema_version"
  ],
  "properties": {
    "span_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "started",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivacyRoutingPolicy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "default_mode": {
      "type": "string",
      "enum": [
        "local_only",
        "local_first",
        "cloud_allowed",
        "cloud_required"
      ]
    },
    "classification_overrides": {
      "type": "object",
      "additionalProperties": true
    },
    "requires_approval_for_cloud": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "default_mode"
  ]
}

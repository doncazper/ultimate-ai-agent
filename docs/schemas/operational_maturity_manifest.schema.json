{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/operational_maturity_manifest.schema.json",
  "title": "Control Center Operational Maturity Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "baseline",
    "ladder_doc_ref",
    "verifier_ref",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": "uaa-control-center-operational-maturity.v1"
    },
    "status": {
      "const": "active operational maturity manifest"
    },
    "baseline": {
      "type": "string"
    },
    "ladder_doc_ref": {
      "const": "docs/control_center/OPERATIONALIZATION_LADDER.md"
    },
    "verifier_ref": {
      "const": "scripts/verify_operational_maturity.py"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "rank",
        "honest_status",
        "smallest_operational_action",
        "backend_routes",
        "receipt_refs",
        "evidence_refs",
        "blocked_authorities",
        "real_local_mutation",
        "durable_receipt",
        "evidence_timeline_event",
        "cli_parity_ref",
        "focused_test_refs"
      ],
      "properties": {
        "lane_id": { "type": "string", "minLength": 1 },
        "rank": { "$ref": "#/$defs/rank" },
        "honest_status": { "type": "string", "minLength": 1 },
        "smallest_operational_action": { "type": "string", "minLength": 1 },
        "backend_routes": { "type": "array", "items": { "type": "string" } },
        "receipt_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "blocked_authorities": { "type": "array", "items": { "type": "string" } },
        "real_local_mutation": { "type": "boolean" },
        "durable_receipt": { "type": "boolean" },
        "evidence_timeline_event": { "type": "boolean" },
        "cli_parity_ref": { "type": ["string", "null"] },
        "focused_test_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "role",
        "primary_surface",
        "current_rank",
        "current_rank_label",
        "honest_status",
        "next_target_rank",
        "smallest_next_operational_action",
        "backend_routes",
        "cli_or_script_refs",
        "receipt_refs",
        "evidence_refs",
        "test_refs",
        "verifier_refs",
        "route_metadata_refs",
        "blocked_authorities",
        "missing_contracts",
        "backend_owned_receipts",
        "exact_scope_required",
        "idempotency_required",
        "rollback_or_safe_disable_required",
        "real_local_mutation",
        "durable_receipt",
        "evidence_timeline_event",
        "graduated_lanes"
      ],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["operator_module", "support", "source"] },
        "primary_surface": { "type": "string", "minLength": 1 },
        "current_rank": { "$ref": "#/$defs/rank" },
        "current_rank_label": { "type": "string", "minLength": 1 },
        "honest_status": { "type": "string", "minLength": 1 },
        "next_target_rank": { "$ref": "#/$defs/rank" },
        "smallest_next_operational_action": { "type": "string", "minLength": 1 },
        "backend_routes": { "type": "array", "items": { "type": "string" } },
        "cli_or_script_refs": { "type": "array", "items": { "type": "string" } },
        "receipt_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "test_refs": { "type": "array", "items": { "type": "string" } },
        "verifier_refs": { "type": "array", "items": { "type": "string" } },
        "route_metadata_refs": { "type": "array", "items": { "type": "string" } },
        "blocked_authorities": { "type": "array", "items": { "type": "string" } },
        "missing_contracts": { "type": "array", "items": { "type": "string" } },
        "backend_owned_receipts": { "type": "boolean" },
        "exact_scope_required": { "type": "boolean" },
        "idempotency_required": { "type": "boolean" },
        "rollback_or_safe_disable_required": { "type": "boolean" },
        "real_local_mutation": { "type": "boolean" },
        "durable_receipt": { "type": "boolean" },
        "evidence_timeline_event": { "type": "boolean" },
        "graduated_lanes": {
          "type": "array",
          "items": { "$ref": "#/$defs/lane" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/operational_maturity_manifest.schema.json",
  "title": "Control Center Operational Maturity Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "baseline",
    "ladder_doc_ref",
    "verifier_ref",
    "authority_tier_doc_ref",
    "authority_tier_model",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": "uaa-control-center-operational-maturity.v1"
    },
    "status": {
      "const": "active operational maturity manifest"
    },
    "baseline": {
      "type": "string"
    },
    "ladder_doc_ref": {
      "const": "docs/control_center/OPERATIONALIZATION_LADDER.md"
    },
    "verifier_ref": {
      "const": "scripts/verify_operational_maturity.py"
    },
    "authority_tier_doc_ref": {
      "const": "docs/control_center/USABLE_AUTHORITY_GRADUATION_PLAN.md"
    },
    "authority_tier_model": {
      "$ref": "#/$defs/authority_tier_model"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "usable_authority_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "tier_id",
        "label",
        "durable_truth_owner",
        "approval_posture",
        "examples",
        "blocked_claims"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "tier_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "durable_truth_owner": { "type": "string", "minLength": 1 },
        "approval_posture": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority_tier_guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier_0_may_remain_ui_owned_for_presentation_only",
        "tier_1_local_read_preview_no_approval_required",
        "tier_2_local_draft_no_approval_required_to_create",
        "tier_2_commit_send_apply_requires_later_authority",
        "tier_3_reversible_local_mutation_must_show_undo_or_safe_disable",
        "tier_4_external_mutation_requires_exact_approval_receipt_idempotency",
        "tier_5_background_standing_authority_requires_mode_domain_lease",
        "control_center_no_durable_truth",
        "draft_available_does_not_mean_send_available",
        "preview_available_does_not_mean_runtime_execution"
      ],
      "properties": {
        "tier_0_may_remain_ui_owned_for_presentation_only": { "const": true },
        "tier_1_local_read_preview_no_approval_required": { "const": true },
        "tier_2_local_draft_no_approval_required_to_create": { "const": true },
        "tier_2_commit_send_apply_requires_later_authority": { "const": true },
        "tier_3_reversible_local_mutation_must_show_undo_or_safe_disable": {
          "const": true
        },
        "tier_4_external_mutation_requires_exact_approval_receipt_idempotency": {
          "const": true
        },
        "tier_5_background_standing_authority_requires_mode_domain_lease": {
          "const": true
        },
        "control_center_no_durable_truth": { "const": true },
        "draft_available_does_not_mean_send_available": { "const": true },
        "preview_available_does_not_mean_runtime_execution": { "const": true }
      }
    },
    "authority_tier_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doctrine", "tiers", "guardrails"],
      "properties": {
        "doctrine": {
          "const": "Earned authority, low friction by default, strict only where consequences justify it."
        },
        "tiers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/usable_authority_tier" }
        },
        "guardrails": { "$ref": "#/$defs/authority_tier_guardrails" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "rank",
        "honest_status",
        "smallest_operational_action",
        "backend_routes",
        "receipt_refs",
        "evidence_refs",
        "blocked_authorities",
        "real_local_mutation",
        "durable_receipt",
        "evidence_timeline_event",
        "rollback_or_safe_disable_required",
        "rollback_or_safe_disable_refs",
        "cli_parity_ref",
        "focused_test_refs"
      ],
      "properties": {
        "lane_id": { "type": "string", "minLength": 1 },
        "rank": { "$ref": "#/$defs/rank" },
        "honest_status": { "type": "string", "minLength": 1 },
        "smallest_operational_action": { "type": "string", "minLength": 1 },
        "backend_routes": { "type": "array", "items": { "type": "string" } },
        "receipt_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "blocked_authorities": { "type": "array", "items": { "type": "string" } },
        "real_local_mutation": { "type": "boolean" },
        "durable_receipt": { "type": "boolean" },
        "evidence_timeline_event": { "type": "boolean" },
        "rollback_or_safe_disable_required": { "type": "boolean" },
        "rollback_or_safe_disable_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cli_parity_ref": { "type": ["string", "null"] },
        "focused_test_refs": { "type": "array", "items": { "type": "string" } },
        "repeatability_gate_ref": { "type": ["string", "null"] },
        "frontend_repeatability_test_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verifier_repeatability_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "authority_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "legacy_lane_id",
        "rank",
        "honest_status",
        "authority_domain_ref",
        "authority_capability_ref",
        "required_mode_ref",
        "authority_lease_requirement_ref",
        "lease_scope",
        "active_lease_required",
        "exact_approval_required",
        "idempotency_required",
        "receipts_required",
        "audit_required",
        "redaction_required",
        "rollback_or_safe_disable_refs",
        "backend_routes",
        "cli_parity_ref",
        "focused_test_refs",
        "operator_copy"
      ],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "legacy_lane_id": { "type": "string", "minLength": 1 },
        "rank": { "$ref": "#/$defs/rank" },
        "honest_status": { "type": "string", "minLength": 1 },
        "authority_domain_ref": { "type": "string", "minLength": 1 },
        "authority_capability_ref": { "type": "string", "minLength": 1 },
        "required_mode_ref": { "type": "string", "minLength": 1 },
        "authority_lease_requirement_ref": { "type": "string", "minLength": 1 },
        "lease_scope": {
          "type": "string",
          "enum": ["session", "mission"]
        },
        "active_lease_required": { "type": "boolean" },
        "exact_approval_required": { "type": "boolean" },
        "idempotency_required": { "type": "boolean" },
        "receipts_required": { "type": "boolean" },
        "audit_required": { "type": "boolean" },
        "redaction_required": { "type": "boolean" },
        "rollback_or_safe_disable_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "backend_routes": { "type": "array", "items": { "type": "string" } },
        "cli_parity_ref": { "type": ["string", "null"] },
        "focused_test_refs": { "type": "array", "items": { "type": "string" } },
        "operator_copy": { "type": "string", "minLength": 1 }
      }
    },
    "ui_status_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "status_route_ref",
        "frontend_endpoint_ref",
        "frontend_client_ref",
        "frontend_type_ref",
        "frontend_component_refs",
        "frontend_test_refs",
        "backend_only_status",
        "backend_only_reason",
        "backend_only_doc_ref",
        "backend_only_blocker_ref",
        "stale_language_scan_refs"
      ],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "status_route_ref": { "type": "string", "minLength": 1 },
        "frontend_endpoint_ref": { "type": ["string", "null"] },
        "frontend_client_ref": { "type": ["string", "null"] },
        "frontend_type_ref": { "type": ["string", "null"] },
        "frontend_component_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frontend_test_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "backend_only_status": { "type": "boolean" },
        "backend_only_reason": { "type": ["string", "null"] },
        "backend_only_doc_ref": { "type": ["string", "null"] },
        "backend_only_blocker_ref": { "type": ["string", "null"] },
        "stale_language_scan_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "role",
        "primary_surface",
        "current_rank",
        "current_rank_label",
        "honest_status",
        "next_target_rank",
        "smallest_next_operational_action",
        "backend_routes",
        "cli_or_script_refs",
        "receipt_refs",
        "evidence_refs",
        "test_refs",
        "verifier_refs",
        "route_metadata_refs",
        "blocked_authorities",
        "missing_contracts",
        "backend_owned_receipts",
        "exact_scope_required",
        "idempotency_required",
        "rollback_or_safe_disable_required",
        "real_local_mutation",
        "durable_receipt",
        "evidence_timeline_event",
        "graduated_lanes"
      ],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["operator_module", "support", "source"] },
        "primary_surface": { "type": "string", "minLength": 1 },
        "current_rank": { "$ref": "#/$defs/rank" },
        "current_rank_label": { "type": "string", "minLength": 1 },
        "honest_status": { "type": "string", "minLength": 1 },
        "next_target_rank": { "$ref": "#/$defs/rank" },
        "smallest_next_operational_action": { "type": "string", "minLength": 1 },
        "backend_routes": { "type": "array", "items": { "type": "string" } },
        "cli_or_script_refs": { "type": "array", "items": { "type": "string" } },
        "receipt_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "test_refs": { "type": "array", "items": { "type": "string" } },
        "verifier_refs": { "type": "array", "items": { "type": "string" } },
        "route_metadata_refs": { "type": "array", "items": { "type": "string" } },
        "blocked_authorities": { "type": "array", "items": { "type": "string" } },
        "missing_contracts": { "type": "array", "items": { "type": "string" } },
        "backend_owned_receipts": { "type": "boolean" },
        "exact_scope_required": { "type": "boolean" },
        "idempotency_required": { "type": "boolean" },
        "rollback_or_safe_disable_required": { "type": "boolean" },
        "real_local_mutation": { "type": "boolean" },
        "durable_receipt": { "type": "boolean" },
        "evidence_timeline_event": { "type": "boolean" },
        "graduated_lanes": {
          "type": "array",
          "items": { "$ref": "#/$defs/lane" }
        },
        "authority_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/authority_capability" }
        },
        "ui_status_binding": { "$ref": "#/$defs/ui_status_binding" }
      }
    }
  }
}

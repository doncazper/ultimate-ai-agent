{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "UAA-local inert metadata import for external A2A-shaped agent data.\n\nReal delegation remains blocked.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "schema_version": {
      "default": "uaa_a2a_agent_card_metadata_import.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "title": "Owner",
      "type": "string"
    },
    "declared_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Declared Capabilities",
      "type": "array"
    },
    "endpoint_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Url"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "name",
    "owner",
    "version"
  ],
  "title": "UAAA2AAgentCardMetadataImport",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-ai-agent.local/schemas/credential_reference.schema.json",
  "title": "CredentialReference",
  "type": "object",
  "required": [
    "credential_ref",
    "provider_id",
    "auth_type",
    "scope",
    "status",
    "created_at",
    "schema_version"
  ],
  "properties": {
    "credential_ref": {
      "type": "string",
      "pattern": "^cred_[A-Za-z0-9_:-]+$"
    },
    "provider_id": {
      "type": "string"
    },
    "auth_type": {
      "enum": [
        "none",
        "api_key",
        "oauth",
        "service_account",
        "user_agent",
        "custom"
      ]
    },
    "scope": {
      "enum": [
        "user",
        "project",
        "workspace",
        "organization",
        "system"
      ]
    },
    "owner_user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired",
        "disabled",
        "pending"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

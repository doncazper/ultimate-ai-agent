{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_evidence",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "support_status": {
      "type": "string"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_status": {
      "type": "string"
    },
    "conflict_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "claim_id",
    "claim_text",
    "support_status",
    "evidence_items",
    "confidence"
  ]
}

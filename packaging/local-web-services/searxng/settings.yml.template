use_default_settings: true

general:
  debug: false
  instance_name: "UAA Local Search"
  donation_url: false
  contact_url: false
  enable_metrics: false

search:
  safe_search: 1
  autocomplete: ""
  favicon_resolver: ""
  default_lang: "en"
  max_page: 1
  ban_time_on_fail: 10
  max_ban_time_on_fail: 300
  formats:
    - html
    - json

server:
  port: 8080
  bind_address: "0.0.0.0"
  base_url: false
  limiter: true
  public_instance: false
  secret_key: "__UAA_SEARXNG_SECRET__"
  image_proxy: false
  method: "GET"

valkey:
  url: valkey://searxng-valkey:6379/0

outgoing:
  request_timeout: 3.0
  max_request_timeout: 5.0
  pool_connections: 20
  pool_maxsize: 5
  enable_http2: true

ui:
  query_in_title: false
  results_on_new_tab: false
  url_formatting: host

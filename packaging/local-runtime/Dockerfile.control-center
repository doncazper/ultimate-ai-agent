# Local-runtime packaging only. This is not a public distribution image.
ARG NODE_BASE_IMAGE=node:22-slim
FROM ${NODE_BASE_IMAGE}

WORKDIR /app

COPY apps/control-center/package.json apps/control-center/package-lock.json ./
RUN npm ci

COPY apps/control-center/ ./

ENV VITE_UAA_API_BASE_URL=http://127.0.0.1:8000

EXPOSE 5173

# The container listens internally; compose publishes only to host loopback.
CMD ["./node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5173"]

# Ultimate AI Agent local environment template.
#
# This file must not contain secret material. Generate local-only secrets under
# ignored `.uaa/` state when a local package explicitly needs them.
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
UAA_FILE_API_SAFE_ROOT=
UAA_OPENWEBUI_TEST_GATEWAY_ENABLED=
UAA_LOCAL_RUNTIME_SECRET_FILE=.uaa/local-runtime/uaa_local_runtime_secret
